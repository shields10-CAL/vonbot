{
  "name": "vonbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source VonBot simulator with four-digit decimal instructions, phase-level reversible stepping, block labels, comments, DAT classification, and time-seeded RND",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/language": "^6.11.3",
    "@codemirror/view": "^6.38.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@uiw/react-codemirror": "^4.25.2",
    "express": "^5.1.0",
    "lz-string": "^1.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@lezer/highlight": "^1.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.8",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
